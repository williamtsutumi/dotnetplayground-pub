@inject Microsoft.Extensions.Localization.IStringLocalizer<WebApplication1.SharedResource> Localizer
@model WebApplication1.Domain.Comunidade.Comunidade
@{ ViewData["Title"] = Localizer["CommunityDeleteAction"].Value; }
<h1>@Localizer["CommunityDeleteConfirmationHeading"]</h1>
<section class="community-card">
    <p>@Localizer["CommunityDeleteConfirmationIntro"] <strong>c/@Model.Nome</strong>@Localizer["CommunityDeleteConfirmationWarning"]</p>
    <p class="community-intro">@Localizer["CommunityDeleteBlockedContentHelp"]</p>
    <div asp-validation-summary="ModelOnly" class="community-errors" role="alert"></div>
    <form asp-action="Excluir" asp-route-id="@Model.Id" method="post"
          data-confirm-delete data-confirm-message="@Localizer["DeleteConfirmation"]" data-confirm-yes="@Localizer["ConfirmYes"]" data-confirm-no="@Localizer["ConfirmNo"]">
        <div class="community-form-actions"><a asp-action="Detalhes" asp-route-id="@Model.Id">@Localizer["FormCancelAction"]</a><button type="submit" class="community-primary community-danger">@Localizer["CommunityDeleteAction"]</button></div>
    </form>
</section>

@section Scripts {
    <script src="~/js/delete-confirmation.js" asp-append-version="true"></script>
}
