@inject Microsoft.Extensions.Localization.IStringLocalizer<WebApplication1.SharedResource> Localizer
@model WebApplication1.Models.FeedModel

@{
    ViewData["Title"] = Localizer["MainFeed"];
}

<partial name="_MarkdownStyles" />
<main class="feed-layout" id="feed" tabindex="-1">
    <section class="feed-column" aria-labelledby="feed-title">
        <div id="feed-header" class="d-flex justify-content-between mb-3">
            <div class="feed-heading"><div><p class="eyebrow">@Localizer["FeedEyebrow"]</p><h1 id="feed-title">@Localizer["MainFeed"]<span class="brand-dot">.</span></h1></div></div>
            <form class="feed-toolbar" asp-controller="Home" asp-action="Index" method="get">
                <label class="align-content-center me-4" for="feed-sort">@Localizer["SortBy"]</label>
                <select id="feed-sort" name="ordem" aria-describedby="sort-help" onchange="this.form.requestSubmit()">
                    <option value="maisantigos" selected="@(Model.Ordem == "maisantigos")">@Localizer["FeedMaisAntigos"]</option>
                    <option value="maisrecentes" selected="@(Model.Ordem == "maisrecentes")">@Localizer["FeedMaisRecentes"]</option>
                    <option value="minhascomunidades" selected="@(Model.Ordem == "minhascomunidades")">@Localizer["FeedMyCommunities"]</option>
                </select>
                <noscript><button type="submit">@Localizer["Sort"]</button></noscript>
            </form>
        </div>
        @if (Model.Indisponivel)
        {
            <p role="alert" class="hub-empty">@Localizer["FeedError"]</p>
        }
        else if (Model.Posts.Count == 0)
        {
            <div class="hub-empty"><h2>@Localizer["NoPosts"]</h2><p>@Localizer["StartConversation"]</p><a class="hub-button" asp-controller="Comunidade" asp-action="Index">@Localizer["ExploreCommunities"]</a></div>
        }
        @foreach (var post in Model.Posts)
        {
            <partial name="_FeedPost" model="post" />
        }
        <nav class="hub-pagination" aria-label="@Localizer["FeedPagination"]">
            @if (Model.Pagina > 1)
            {
                <a class="hub-button" asp-action="Index" asp-route-ordem="@Model.Ordem" asp-route-pagina="@(Model.Pagina - 1)">@Localizer["Previous"]</a>
            }
            @if (Model.TemProxima)
            {
                <a class="hub-button" asp-action="Index" asp-route-ordem="@Model.Ordem" asp-route-pagina="@(Model.Pagina + 1)">@Localizer["Next"]</a>
            }
        </nav>
    </section>
    <aside class="discovery">
        <div class="welcome-card"><span class="eyebrow">@Localizer["YourPlayground"]</span><h2>@Localizer["DifferentIdeas"]<br />@Localizer["SharedSpace"]</h2><p>@Localizer["FollowConversations"]</p><a asp-controller="Comunidade" asp-action="Index">@Localizer["ExploreArrow"]</a></div>
        <div class="sidebar-bottom"><a asp-controller="About" asp-action="Index">@Localizer["AboutProject"] <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a></div>
    </aside>
</main>

@section Scripts {
    @if (Model.Posts.Any(post => post.ConteudoMarkdown))
    {
        <partial name="_MarkdownScripts" />
        <script src="~/js/post-markdown.js" asp-append-version="true"></script>
    }
}
